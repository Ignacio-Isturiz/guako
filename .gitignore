# Secretos y variables de entorno (nunca se suben)
.env
.env.*
!.env.example
# Config pública del build móvil (solo la URL del backend)
!frontend/.env.mobile

# Dependencias y compilados
node_modules/
dist/
dist-ssr/
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Registros
logs/
*.log

# Configuración local de Claude Code
.claude/settings.local.json

.claude

# Editores y sistema operativo
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp
*.suo

# Archivos temporales y copias locales
*.local
tmp/
*.db

# Audio (grabaciones de voz: nunca se suben). Los de tests/fixtures son datos de prueba y sí van.
*.m4a
*.wav
*.ogg
*.mp3
*.webm
*.flac
!backend/tests/fixtures/**

# Capturas para las tiendas (~20 MB): se regeneran con `node frontend/scripts/store-screenshots.mjs`
docs/tiendas/capturas/
