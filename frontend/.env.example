# Copia este archivo a .env.local y ajusta los valores. No pongas claves aquí: el frontend es público.

# URL base del backend. Vacío = mismo origen (en desarrollo Vite redirige /api a 127.0.0.1:8000).
# La app móvil usa .env.mobile (npm run build:mobile), con la URL completa del backend.
VITE_API_URL=

# true = conversación e informe con datos de ejemplo, sin backend (respaldo).
VITE_DEMO_MODE=false

# true = sesión de demostración sin backend (cualquier cuenta entra). También activa el modo demo.
VITE_AUTH_MOCK=false

# Enlaces de las tiendas para el botón "Instalar la app en el celular" de la landing.
# Vacío = se instala como app web (Android: aviso de Chrome; iPhone: pasos de Safari "Agregar a inicio").
# Ej.: https://play.google.com/store/apps/details?id=com.guako.app · https://apps.apple.com/app/id<número>
VITE_PLAY_STORE_URL=
VITE_APP_STORE_URL=
