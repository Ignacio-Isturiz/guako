# Copy to .env and fill in. NEVER commit .env.

# --- PostgreSQL (read by the pgvector/pgvector container) ---
# Database superuser name.
POSTGRES_USER=guako
# Database password. Use a long random value; avoid characters like @ : / # in it
# because it is embedded in DATABASE_URL below.
POSTGRES_PASSWORD=change-me-example-only
# Name of the database created on first start.
POSTGRES_DB=guako

# --- API ---
# SQLAlchemy async URL. Host "db" is the compose service name.
# For running the API outside Docker, use localhost instead of db.
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
# Allowed browser origins (JSON list).
CORS_ORIGINS=["http://localhost:5173"]
# Signs session tokens. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET=change-me-example-only
# true in production (HTTPS only).
COOKIE_SECURE=false

# --- LLM ---
# Which providers answer, in order, are set in the "Provider router" section below.
# Gemini API key (leave empty here; fill only in your local .env).
GEMINI_API_KEY=
# Groq API key (leave empty here; fill only in your local .env).
GROQ_API_KEY=
# Optional overrides (uncomment to change the defaults):
# Gemini model name.
# GEMINI_MODEL=gemini-3.5-flash-lite
# Groq model name.
# GROQ_MODEL=openai/gpt-oss-20b
# Reasoning effort of the Groq model in the conversation (low, medium, high; empty = not sent).
# The background analysis always uses the model default.
# GROQ_CONVERSATION_REASONING_EFFORT=low
# Sampling temperature (0.0 - 2.0).
# LLM_TEMPERATURE=0.2
# Per-call timeout in seconds.
# LLM_TIMEOUT_SECONDS=30
# Extra attempts when the output fails validation.
# LLM_MAX_RETRIES=2

# --- Speech-to-text (Groq Whisper; uses GROQ_API_KEY above) ---
# Whisper model name on Groq (whisper-large-v3 or whisper-large-v3-turbo).
# STT_MODEL=whisper-large-v3-turbo
# Language hint for Whisper (ISO-639-1). Keep "en": auto-detect misreads accented English.
# STT_LANGUAGE=en
# Per-request timeout in seconds.
# STT_TIMEOUT_SECONDS=10

# --- Text-to-speech (Groq Orpheus; uses GROQ_API_KEY above) ---
# Optional overrides (uncomment to change the defaults):
# Orpheus voice: autumn, diana, hannah, austin, daniel or troy.
# TTS_VOICE=hannah
# Orpheus model name.
# TTS_MODEL=canopylabs/orpheus-v1-english
# Per-request timeout in seconds.
# TTS_TIMEOUT_SECONDS=10
# Directory of the synthesized-audio cache.
# TTS_CACHE_DIR=cache/tts

# --- Conversation ---
# Directory for session audio files.
# SESSIONS_AUDIO_DIR=output/sessions
# Largest accepted audio upload per turn, in bytes.
# MAX_TURN_AUDIO_BYTES=10485760

# --- OpenAI (paid; optional: the app keeps working without it) ---
# OpenAI API key (leave empty here; fill only in your local .env).
OPENAI_API_KEY=
# Models (Whisper must be whisper-1: it gives word timestamps and accepts a context prompt).
# OPENAI_LLM_MODEL=gpt-4o-mini
# OPENAI_STT_MODEL=whisper-1
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy

# --- Provider router ---
# Order in which providers answer each capability (comma separated: groq, gemini, openai). The first one
# that is healthy, within quota and (if paid) within budget answers; the rest are the backup.
# LLM_CONVERSATION_ORDER=groq,openai,gemini
# LLM_ANALYSIS_ORDER=openai,groq,gemini
# STT_ORDER=groq,openai
# TTS_ORDER=groq,openai
# Stop using a provider for a capability after N requests a day, before it answers 429 (cache hits do not count).
# PROVIDER_DAILY_CAPS=groq:tts=90
# Spending cap for paid providers, in USD, estimated by us (not OpenAI's invoice). 0 disables paid providers.
# PAID_BUDGET_USD=5
# PAID_BUDGET_PERIOD=month   # day, month or total
# Warn in the log at this fraction of the cap; at 100 % paid providers are skipped.
# PAID_BUDGET_WARN_FRACTION=0.8
# Prices used for the estimate (USD). NOT VERIFIED: check platform.openai.com/pricing, set them, then confirm.
# PRICE_OPENAI_LLM_INPUT_PER_M=0.15
# PRICE_OPENAI_LLM_OUTPUT_PER_M=0.60
# PRICE_OPENAI_STT_PER_MINUTE=0.006
# PRICE_OPENAI_TTS_PER_MINUTE=0.015
# TTS_COST_SAFETY_FACTOR=1.3
# OPENAI_PRICES_CONFIRMED=false
# Circuit breaker: consecutive failures that open it, first wait (doubles up to the max), and the longest
# wait a 429 may ask before the breaker opens at once for that long.
# BREAKER_FAILURE_THRESHOLD=3
# BREAKER_COOLDOWN_SECONDS=30
# BREAKER_MAX_COOLDOWN_SECONDS=600
# BREAKER_QUOTA_WAIT_SECONDS=60
# BREAKER_MAX_OPEN_SECONDS=3600

# --- Limits ---
# Audio minutes (learner + tutor) a user can use per day.
# DAILY_LIMIT_MINUTES=20

# --- Azure Speech (Pronunciation Assessment; free F0 plan, 5 audio hours/month) ---
# Key and region of the Speech resource (leave empty here; fill only in your local .env).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- Observability (Langfuse Cloud: cloud.langfuse.com -> project -> Settings -> API Keys) ---
# Without both keys tracing is off. Audio is never sent; emails and phone numbers are masked.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com   # EU; US: https://us.cloud.langfuse.com
# LANGFUSE_ENVIRONMENT=development
# LANGFUSE_SAMPLE_RATE=1.0
# False = only timings, models, tokens and costs (no prompts, transcripts or answers).
# LANGFUSE_CAPTURE_CONTENT=true
