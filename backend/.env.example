# Copy to .env and fill in. NEVER commit .env.

# --- PostgreSQL (read by the pgvector/pgvector container) ---
# Database superuser name.
POSTGRES_USER=guako
# Database password. Use a long random value; avoid characters like @ : / # in it
# because it is embedded in DATABASE_URL below.
POSTGRES_PASSWORD=change-me-example-only
# Name of the database created on first start.
POSTGRES_DB=guako

# --- API ---
# SQLAlchemy async URL. Host "db" is the compose service name.
# For running the API outside Docker, use localhost instead of db.
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
# Allowed browser origins (JSON list).
CORS_ORIGINS=["http://localhost:5173"]
# Signs session tokens. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET=change-me-example-only
# true in production (HTTPS only).
COOKIE_SECURE=false

# --- LLM ---
# Primary provider: groq or gemini.
LLM_PROVIDER=groq
# Backup used when the primary fails: gemini, groq or none. Needs its own API key below.
LLM_FALLBACK_PROVIDER=gemini
# Gemini API key (leave empty here; fill only in your local .env).
GEMINI_API_KEY=
# Groq API key (leave empty here; fill only in your local .env).
GROQ_API_KEY=
# Optional overrides (uncomment to change the defaults):
# Gemini model name.
# GEMINI_MODEL=gemini-3.5-flash-lite
# Groq model name.
# GROQ_MODEL=openai/gpt-oss-20b
# Sampling temperature (0.0 - 2.0).
# LLM_TEMPERATURE=0.2
# Per-call timeout in seconds.
# LLM_TIMEOUT_SECONDS=30
# Extra attempts when the output fails validation.
# LLM_MAX_RETRIES=2

# --- Speech-to-text (Groq Whisper; uses GROQ_API_KEY above) ---
# Whisper model name on Groq (whisper-large-v3 or whisper-large-v3-turbo).
# STT_MODEL=whisper-large-v3
# Language hint for Whisper (ISO-639-1). Keep "en": auto-detect misreads accented English.
# STT_LANGUAGE=en
# Per-request timeout in seconds.
# STT_TIMEOUT_SECONDS=10

# --- Text-to-speech (Groq Orpheus; uses GROQ_API_KEY above) ---
# Optional overrides (uncomment to change the defaults):
# Orpheus voice: autumn, diana, hannah, austin, daniel or troy.
# TTS_VOICE=hannah
# Orpheus model name.
# TTS_MODEL=canopylabs/orpheus-v1-english
# Per-request timeout in seconds.
# TTS_TIMEOUT_SECONDS=10
# Directory of the synthesized-audio cache.
# TTS_CACHE_DIR=cache/tts

# --- Conversation ---
# Directory for session audio files.
# SESSIONS_AUDIO_DIR=output/sessions
# Largest accepted audio upload per turn, in bytes.
# MAX_TURN_AUDIO_BYTES=10485760

# --- Text-to-speech backup (OpenAI, paid: used only when Groq TTS fails or hits its quota) ---
# Backup for TTS: openai or none.
# TTS_FALLBACK_PROVIDER=openai
# OpenAI API key (leave empty here; fill only in your local .env).
OPENAI_API_KEY=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy

# --- Limits ---
# Audio minutes (learner + tutor) a user can use per day.
# DAILY_LIMIT_MINUTES=20

# --- Azure Speech (Pronunciation Assessment; free F0 plan, 5 audio hours/month) ---
# Key and region of the Speech resource (leave empty here; fill only in your local .env).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
