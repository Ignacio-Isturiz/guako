CORS_ORIGINS=["http://localhost:5173"]
# Genera una clave larga y aleatoria:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET=cambia-esto-en-produccion
DATABASE_URL=sqlite+aiosqlite:///./guako.db
# true en producción (HTTPS)
COOKIE_SECURE=false

# LLM (gemini o groq). Rellena las claves solo en tu .env local
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
# Opcionales (descomenta para sobrescribir los valores por defecto):
# GEMINI_MODEL=gemini-3.5-flash-lite
# GROQ_MODEL=openai/gpt-oss-20b
# LLM_TEMPERATURE=0.2
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_RETRIES=2
